NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# MCPFactory API (omit for mock mode)
API_SERVICE_URL=https://api.mcpfactory.org

# Chat Service (omit for mock mode)
CHAT_SERVICE_URL=https://chat.mcpfactory.org
CHAT_SERVICE_API_KEY=sk_chat_...

# Key Service — register app secrets at startup
KEY_SERVICE_URL=https://key.mcpfactory.org
KEY_SERVICE_API_KEY=sk_key_...

# Gemini — used by chat-service, registered with key-service at startup
GEMINI_API_KEY=AIza...

# Stripe — registered with key-service, never used directly at runtime
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional Email Service — register templates at startup
TRANSACTIONAL_EMAIL_SERVICE_URL=https://transactional-email.mcpfactory.org
TRANSACTIONAL_EMAIL_SERVICE_API_KEY=sk_email_...
