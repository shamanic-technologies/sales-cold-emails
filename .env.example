# Gemini — registered with api-service at startup
GEMINI_API_KEY=AIza...

# Stripe — registered with api-service at startup, never used directly at runtime
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional Email Service — register templates at startup
TRANSACTIONAL_EMAIL_SERVICE_URL=https://transactional-email.mcpfactory.org
TRANSACTIONAL_EMAIL_SERVICE_API_KEY=sk_email_...
